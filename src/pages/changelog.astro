---
import { marked } from 'marked';

const REPO = 'netclaw-dev/netclaw';

let releases = [];
let fetchError = null;

try {
  const headers = {
    Accept: 'application/vnd.github+json',
    'X-GitHub-Api-Version': '2022-11-28',
    'User-Agent': 'netclaw-website-build',
  };
  if (process.env.GH_TOKEN) {
    headers.Authorization = `Bearer ${process.env.GH_TOKEN}`;
  }
  const res = await fetch(
    `https://api.github.com/repos/${REPO}/releases?per_page=100`,
    { headers },
  );
  if (!res.ok) {
    throw new Error(`GitHub API responded ${res.status} ${res.statusText}`);
  }
  const data = await res.json();
  releases = data
    .filter((r) => !r.draft)
    .sort((a, b) => new Date(b.published_at) - new Date(a.published_at))
    .map((r) => ({
      tag: r.tag_name.replace(/^v/i, ''),
      name: r.name && r.name !== r.tag_name ? r.name : null,
      url: r.html_url,
      date: r.published_at,
      prerelease: r.prerelease,
      bodyHtml: marked.parse(r.body || '_No release notes._'),
    }));
} catch (e) {
  fetchError = e.message;
  console.warn('[changelog] failed to fetch GitHub releases:', e.message);
}

const formatDate = (iso) =>
  new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NY61NRBJ68"></script>
  <script>window.dataLayer = window.dataLayer || [];function gtag(){dataLayer.push(arguments);}gtag('js', new Date());gtag('config', 'G-NY61NRBJ68');</script>

  <title>Changelog — Netclaw</title>
  <meta name="description" content="Release notes and version history for Netclaw — pulled live from GitHub Releases.">
  <meta name="theme-color" content="#512BD4">

  <!-- Open Graph -->
  <meta property="og:title" content="Changelog — Netclaw">
  <meta property="og:description" content="Release notes and version history for Netclaw.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://netclaw.dev/changelog">
  <meta property="og:site_name" content="Netclaw">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@petabridge">
  <meta name="twitter:title" content="Changelog — Netclaw">
  <meta name="twitter:description" content="Release notes and version history for Netclaw.">

  <link rel="icon" href="/assets/favicons/favicon.ico" sizes="any">
  <link rel="icon" href="/assets/favicons/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/favicons/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap">

  <style is:inline>
    :root {
      --purple: #512BD4;
      --purple-hover: #6d3fe8;
      --purple-soft: rgba(81, 43, 212, 0.15);
      --ink: #0f1117;
      --dark: #1a1a2e;
      --paper: #ffffff;
      --mute: #8a8fa3;
      --mute-light: #c2c5cf;
      --teal: #00d4aa;
      --teal-dim: rgba(0, 212, 170, 0.15);
      --max-width: 920px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 80px; }

    body {
      font-family: 'Space Grotesk', -apple-system, system-ui, sans-serif;
      color: var(--paper);
      background: var(--ink);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .skip-link {
      position: absolute;
      top: -100px;
      left: 16px;
      background: var(--purple);
      color: var(--paper);
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      z-index: 200;
      transition: top 0.15s;
    }
    .skip-link:focus { top: 8px; }
    :focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }

    /* ---- NAV ---- */
    .nav {
      position: sticky;
      top: 0;
      background: rgba(15, 17, 23, 0.85);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      z-index: 100;
    }
    .nav-inner {
      max-width: 1120px;
      margin: 0 auto;
      padding: 16px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .nav-logo {
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--paper);
      font-weight: 700;
      font-size: 1.1rem;
      text-decoration: none;
    }
    .nav-logo img { width: 28px; height: 28px; }
    .nav-links {
      display: flex;
      gap: 24px;
      list-style: none;
    }
    .nav-links a {
      color: var(--mute-light);
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 500;
      transition: color 0.15s;
    }
    .nav-links a:hover { color: var(--paper); }
    .nav-links a[aria-current="page"] { color: var(--teal); }
    @media (max-width: 720px) { .nav-links { display: none; } }

    /* ---- HEADER ---- */
    .changelog-header {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 72px 32px 32px;
    }
    .changelog-header .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--teal-dim);
      border: 1px solid rgba(0, 212, 170, 0.3);
      border-radius: 100px;
      padding: 5px 14px;
      font-size: 0.74rem;
      font-weight: 500;
      color: var(--teal);
      margin-bottom: 20px;
      text-decoration: none;
    }
    .changelog-header .eyebrow:hover {
      background: rgba(0, 212, 170, 0.22);
    }
    .changelog-header h1 {
      font-size: 2.6rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      margin-bottom: 14px;
    }
    .changelog-header .lede {
      color: var(--mute-light);
      font-size: 1.05rem;
      max-width: 640px;
    }
    .changelog-header .lede a {
      color: var(--teal);
      text-decoration: none;
    }
    .changelog-header .lede a:hover { text-decoration: underline; }

    /* ---- TIMELINE ---- */
    .timeline {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 12px 32px 100px;
    }

    .release {
      padding: 28px 32px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.025);
      margin-bottom: 24px;
      transition: border-color 0.2s, background 0.2s;
      scroll-margin-top: 96px;
    }
    .release:hover {
      border-color: rgba(81, 43, 212, 0.4);
      background: rgba(255, 255, 255, 0.035);
    }

    .release-header {
      display: flex;
      align-items: baseline;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 6px;
    }
    .release-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--paper);
      letter-spacing: -0.01em;
    }
    .release-tag a {
      color: inherit;
      text-decoration: none;
    }
    .release-tag a:hover { color: var(--teal); }
    .release-prerelease {
      display: inline-block;
      padding: 2px 10px;
      background: var(--purple-soft);
      border: 1px solid rgba(81, 43, 212, 0.4);
      border-radius: 100px;
      color: #b29bff;
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }
    .release-date {
      color: var(--mute);
      font-size: 0.88rem;
      margin-left: auto;
    }
    .release-name {
      color: var(--mute-light);
      font-size: 0.98rem;
      margin-bottom: 18px;
    }

    /* ---- RELEASE BODY (rendered markdown) ---- */
    .release-body {
      color: var(--mute-light);
      font-size: 0.95rem;
      line-height: 1.7;
    }
    .release-body > :first-child { margin-top: 0; }
    .release-body > :last-child { margin-bottom: 0; }
    .release-body h1,
    .release-body h2,
    .release-body h3,
    .release-body h4 {
      color: var(--paper);
      font-weight: 600;
      letter-spacing: -0.01em;
      margin: 22px 0 10px;
      line-height: 1.3;
    }
    .release-body h1 { font-size: 1.3rem; }
    .release-body h2 { font-size: 1.18rem; }
    .release-body h3 { font-size: 1.05rem; }
    .release-body h4 { font-size: 0.98rem; }
    .release-body p { margin-bottom: 12px; }
    .release-body ul,
    .release-body ol { margin: 4px 0 14px 24px; }
    .release-body li { margin-bottom: 4px; }
    .release-body li > p { margin-bottom: 4px; }
    .release-body a {
      color: var(--teal);
      text-decoration: none;
    }
    .release-body a:hover { text-decoration: underline; }
    .release-body code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85em;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 1px 6px;
      border-radius: 4px;
      color: var(--paper);
    }
    .release-body pre {
      background: #0d0d14;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      padding: 14px 16px;
      margin: 12px 0;
      overflow-x: auto;
      font-size: 0.82rem;
      line-height: 1.6;
    }
    .release-body pre code {
      background: none;
      border: none;
      padding: 0;
      color: var(--paper);
    }
    .release-body blockquote {
      border-left: 3px solid var(--purple);
      padding: 4px 16px;
      margin: 12px 0;
      color: var(--mute-light);
      font-style: italic;
      background: rgba(81, 43, 212, 0.06);
      border-radius: 0 6px 6px 0;
    }
    .release-body hr {
      border: none;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      margin: 20px 0;
    }
    .release-body img {
      max-width: 100%;
      border-radius: 8px;
      margin: 8px 0;
    }
    .release-body table {
      border-collapse: collapse;
      margin: 12px 0;
      width: 100%;
      font-size: 0.9rem;
    }
    .release-body th,
    .release-body td {
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 8px 12px;
      text-align: left;
    }
    .release-body th {
      background: rgba(255, 255, 255, 0.04);
      font-weight: 600;
      color: var(--paper);
    }

    .empty,
    .error {
      max-width: var(--max-width);
      margin: 60px auto;
      padding: 24px 32px;
      border: 1px dashed rgba(255, 255, 255, 0.15);
      border-radius: 12px;
      color: var(--mute-light);
      text-align: center;
    }
    .error a {
      color: var(--teal);
      text-decoration: none;
    }
    .error a:hover { text-decoration: underline; }

    /* ---- FOOTER ---- */
    .footer {
      background: var(--ink);
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding: 32px;
    }
    .footer-inner {
      max-width: 1120px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: space-between;
      align-items: center;
      color: var(--mute);
      font-size: 0.86rem;
    }
    .footer a {
      color: var(--mute-light);
      text-decoration: none;
    }
    .footer a:hover { color: var(--paper); }

    @media (max-width: 720px) {
      .nav-inner { padding: 12px 18px; }
      .changelog-header { padding: 56px 20px 24px; }
      .changelog-header h1 { font-size: 2rem; }
      .timeline { padding: 6px 16px 60px; }
      .release { padding: 22px 18px; }
      .release-tag { font-size: 1.25rem; }
      .release-date { margin-left: 0; width: 100%; }
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <img src="/assets/netclaw-icon-purple.svg" alt="" aria-hidden="true">
        <span>netclaw</span>
      </a>
      <ul class="nav-links">
        <li><a href="/#features">Features</a></li>
        <li><a href="/#get-started">Get Started</a></li>
        <li><a href="/changelog" aria-current="page">Changelog</a></li>
        <li><a href="/getting-started/installation/">Docs</a></li>
        <li><a href="https://github.com/netclaw-dev/netclaw" target="_blank" rel="noopener">GitHub</a></li>
      </ul>
    </div>
  </nav>

  <header class="changelog-header">
    <a class="eyebrow" href={`https://github.com/${REPO}/releases`} target="_blank" rel="noopener">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/></svg>
      Pulled from GitHub Releases
    </a>
    <h1 id="main-content">Changelog</h1>
    <p class="lede">
      Every release of <a href={`https://github.com/${REPO}`} target="_blank" rel="noopener">netclaw-dev/netclaw</a>, newest first. This page rebuilds when a new release is published, so it's always in sync with the source.
    </p>
  </header>

  <main class="timeline">
    {fetchError && (
      <div class="error">
        <p>Couldn't load releases from GitHub during the last build.</p>
        <p style="margin-top:8px"><a href={`https://github.com/${REPO}/releases`} target="_blank" rel="noopener">View releases on GitHub →</a></p>
      </div>
    )}

    {!fetchError && releases.length === 0 && (
      <div class="empty">No releases published yet.</div>
    )}

    {releases.map((r) => (
      <article class="release" id={r.tag}>
        <div class="release-header">
          <h2 class="release-tag"><a href={r.url} target="_blank" rel="noopener">v{r.tag}</a></h2>
          {r.prerelease && <span class="release-prerelease">Pre-release</span>}
          <time class="release-date" datetime={r.date}>{formatDate(r.date)}</time>
        </div>
        {r.name && <p class="release-name">{r.name}</p>}
        <div class="release-body" set:html={r.bodyHtml} />
      </article>
    ))}
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>&copy; 2026 <a href="https://petabridge.com" target="_blank" rel="noopener">Petabridge, LLC</a> &middot; <a href="https://github.com/netclaw-dev/netclaw/blob/main/LICENSE" target="_blank" rel="noopener">Apache 2.0</a></div>
      <div><a href="/">netclaw.dev</a></div>
    </div>
  </footer>
</body>
</html>
