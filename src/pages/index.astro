  <!-- How It Works -->
  <section class="how-it-works">
    <div class="how-it-works-inner">
      <p class="section-label">How It Works</p>
      <h2>How Netclaw handles a request</h2>
      <p>Something triggers Netclaw. It figures out what to do, checks whether it needs your OK, then does it and tells you what happened.</p>

      <!-- Desktop flow diagram -->
      <div class="flow-diagram">
        <!-- Triggers -->
        <div class="flow-stage">
          <span class="flow-stage-label">Triggers</span>
          <div class="flow-triggers">
            <div class="flow-trigger-pill">Webhook</div>
            <div class="flow-trigger-pill">Slack message</div>
            <div class="flow-trigger-pill">Schedule fires</div>
          </div>
        </div>

        <div class="flow-arrow">
          <svg viewBox="0 0 32 12" fill="none"><line x1="0" y1="6" x2="26" y2="6" stroke="currentColor" stroke-width="1.5"/><polygon points="26,2 32,6 26,10" fill="currentColor"/></svg>
        </div>

        <!-- Agent -->
        <div class="flow-stage">
          <span class="flow-stage-label">Agent</span>
          <div class="flow-node flow-node-agent">
            <h4>netclawd</h4>
            <p>Evaluates context,<br>picks tools</p>
          </div>
        </div>

        <div class="flow-arrow">
          <svg viewBox="0 0 32 12" fill="none"><line x1="0" y1="6" x2="26" y2="6" stroke="currentColor" stroke-width="1.5"/><polygon points="26,2 32,6 26,10" fill="currentColor"/></svg>
        </div>

        <!-- Decision -->
        <div class="flow-stage">
          <span class="flow-stage-label">Decision</span>
          <div class="flow-diamond">
            <div class="flow-diamond-shape"></div>
            <span class="flow-diamond-text">Needs<br>approval?</span>
          </div>
        </div>

        <div class="flow-arrow">
          <svg viewBox="0 0 32 12" fill="none"><line x1="0" y1="6" x2="26" y2="6" stroke="currentColor" stroke-width="1.5"/><polygon points="26,2 32,6 26,10" fill="currentColor"/></svg>
        </div>

        <!-- Branch -->
        <div class="flow-stage">
          <span class="flow-stage-label">Action</span>
          <div class="flow-branch-row">
            <div class="flow-node" style="border-color: rgba(0, 212, 170, 0.3);">
              <span class="flow-branch-label yes">Yes &rarr;</span>
              <p>Asks in Slack</p>
            </div>
            <div class="flow-node">
              <span class="flow-branch-label no">No &rarr;</span>
              <p>Runs automatically</p>
            </div>
          </div>
        </div>

        <div class="flow-arrow">
          <svg viewBox="0 0 32 12" fill="none"><line x1="0" y1="6" x2="26" y2="6" stroke="currentColor" stroke-width="1.5"/><polygon points="26,2 32,6 26,10" fill="currentColor"/></svg>
        </div>

        <!-- Result -->
        <div class="flow-stage">
          <span class="flow-stage-label">Result</span>
          <div class="flow-node flow-node-result">
            <h4>Reports back</h4>
            <p>Full audit trail<br>in your channel</p>
          </div>
        </div>
      </div>

      <!-- Mobile flow (vertical steps) -->
      <div class="flow-mobile">
        <div class="flow-mobile-steps">
          <div class="flow-mobile-step">
            <div class="flow-mobile-num">1</div>
            <div class="flow-mobile-text">
              <h4>Event arrives</h4>
              <p>Webhook, Slack message, or scheduled task</p>
            </div>
          </div>
          <div class="flow-mobile-connector"></div>
          <div class="flow-mobile-step">
            <div class="flow-mobile-num">2</div>
            <div class="flow-mobile-text">
              <h4>netclawd evaluates</h4>
              <p>Picks the right tools for the job</p>
            </div>
          </div>
          <div class="flow-mobile-connector"></div>
          <div class="flow-mobile-step">
            <div class="flow-mobile-num">3</div>
            <div class="flow-mobile-text">
              <h4>Approval check</h4>
              <p>Asks in Slack if needed, runs automatically if safe</p>
            </div>
          </div>
          <div class="flow-mobile-connector"></div>
          <div class="flow-mobile-step">
            <div class="flow-mobile-num">4</div>
            <div class="flow-mobile-text">
              <h4>Reports back</h4>
              <p>Full audit trail in your channel</p>
            </div>
          </div>
        </div>
      </div>
    </div>
