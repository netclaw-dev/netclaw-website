{
  "name": "netclaw-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run copy-screenshots && astro dev",
    "build": "npm run copy-screenshots && node scripts/generate-social-images.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check-version": "node scripts/check-docs-version.mjs",
    "copy-screenshots": "mkdir -p public/screenshots/output && rsync -a --delete screenshots/output/ public/screenshots/output/"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "astro": "^6.2.0",
    "mermaid": "^11.16.0",
    "rehype-mermaid": "^3.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "marked": "^18.0.7",
    "playwright": "^1.62.0"
  }
}
