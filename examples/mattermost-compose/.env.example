# Copy to .env and fill in. Compose reads .env automatically.

# Postgres password for the mattermost database user.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Where you open Mattermost in a browser. Use your real https URL later.
MATTERMOST_SITE_URL=http://localhost:8065

# Inference: any OpenAI-compatible endpoint (llama.cpp, vLLM, ...). The address works with or without a /v1 suffix.
# configure-netclaw.sh reads these. The compose file doesn't use them.
INFERENCE_BASE_URL=http://llm.example.internal:8080
INFERENCE_MODEL_ID=your-model-id

# provision.sh appends MM_CHANNEL_ID and MM_USER_ID here. Don't set them by hand.
