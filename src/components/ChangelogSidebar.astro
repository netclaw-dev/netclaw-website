---
import { shortDate } from '../lib/releases.js';

interface Release {
  tag: string;
  date: string;
  prerelease: boolean;
}

interface Props {
  releases: Release[];
  currentTag?: string;
}

const { releases, currentTag } = Astro.props;
---

<aside class="changelog-sidebar" aria-label="All versions">
  <details open>
    <summary>
      <span>All versions</span>
      <span class="ver-count">{releases.length}</span>
    </summary>
    <ol>
      {releases.map((r) => (
        <li>
          <a
            href={`/changelog/${r.tag}`}
            class:list={[{ active: r.tag === currentTag }]}
            aria-current={r.tag === currentTag ? 'page' : undefined}
          >
            <span class="ver">v{r.tag}</span>
            <span class="ver-meta">
              {r.prerelease && <span class="ver-pre-dot" aria-label="Pre-release"></span>}
              <span class="ver-date">{shortDate(r.date)}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </details>
</aside>

<script>
  // On narrow viewports, default the sidebar to collapsed so it doesn't
  // shove 56 entries above the release notes. Desktop stays expanded.
  if (typeof window !== 'undefined' && window.matchMedia('(max-width: 900px)').matches) {
    document.querySelector('.changelog-sidebar details')?.removeAttribute('open');
  }
</script>

<style>
  .changelog-sidebar {
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    padding: 4px 10px 4px 0;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
  }
  .changelog-sidebar::-webkit-scrollbar { width: 6px; }
  .changelog-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
  }

  .changelog-sidebar details { border: none; }

  .changelog-sidebar summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding: 0 8px;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #8a8fa3;
  }
  .changelog-sidebar summary::-webkit-details-marker { display: none; }

  .changelog-sidebar .ver-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    color: #8a8fa3;
    text-transform: none;
    letter-spacing: 0;
  }

  .changelog-sidebar ol {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
  }

  .changelog-sidebar a {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: baseline;
    padding: 6px 10px;
    border-radius: 6px;
    border-left: 2px solid transparent;
    color: #c2c5cf;
    text-decoration: none;
    transition: color 0.15s, background 0.15s, border-color 0.15s;
  }
  .changelog-sidebar a:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.04);
  }
  .changelog-sidebar a.active {
    color: #00d4aa;
    background: rgba(0, 212, 170, 0.15);
    border-left-color: #00d4aa;
  }

  .changelog-sidebar .ver {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .changelog-sidebar .ver-meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    color: #8a8fa3;
    white-space: nowrap;
  }
  .changelog-sidebar a.active .ver-meta {
    color: #00d4aa;
    opacity: 0.85;
  }

  .changelog-sidebar .ver-pre-dot {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #b29bff;
    box-shadow: 0 0 0 2px rgba(81, 43, 212, 0.2);
  }

  @media (max-width: 900px) {
    .changelog-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0;
      margin-bottom: 24px;
    }
    .changelog-sidebar summary {
      cursor: pointer;
      padding: 14px 16px;
      margin: 0;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
    }
    .changelog-sidebar details[open] summary {
      border-bottom-left-radius: 0;
      border-bottom-right-radius: 0;
    }
    .changelog-sidebar summary::after {
      content: '▾';
      display: inline-block;
      margin-left: 8px;
      transition: transform 0.2s;
      color: #c2c5cf;
    }
    .changelog-sidebar details:not([open]) summary::after {
      transform: rotate(-90deg);
    }
    .changelog-sidebar details[open] ol {
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-top: 0;
      border-radius: 0 0 10px 10px;
      padding: 8px;
      max-height: 50vh;
      overflow-y: auto;
    }
  }
</style>
