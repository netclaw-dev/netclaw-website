  <meta property="og:description" content="Simple, secure, reliable agents. Self-hosted AI that connects to the communications tools you and your team use.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://netclaw.dev">
  <meta property="og:site_name" content="Netclaw">
  <meta property="og:image" content="https://hcti.io/v1/image/019dfa19-dbdf-7ad0-b8c4-ec9f46ea7abf">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@petabridge">
  <meta name="twitter:title" content="Netclaw — Run your own agent.">
  <meta name="twitter:description" content="Simple, secure, reliable agents. Self-hosted AI that connects to the communications tools you and your team use.">
  <meta name="twitter:image" content="https://hcti.io/v1/image/019dfa19-dbdf-7ad0-b8c4-ec9f46ea7abf">

  <!-- Favicons -->
  <link rel="icon" href="/assets/favicons/favicon.ico" sizes="any">
  <link rel="icon" href="/assets/favicons/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="icon" href="/assets/favicons/favicon-64.png" type="image/png" sizes="64x64">
  <link rel="apple-touch-icon" href="/assets/favicons/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.json">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap">

  <style is:inline>
    /* ============================================================
       Netclaw Variant B — "Terminal-Forward Hero"
       Dark theme, terminal-centric, real product feel
       ============================================================ */

    :root {
      --purple: #512BD4;
      --purple-hover: #6d3fe8;
      --purple-glow: rgba(81, 43, 212, 0.45);
      --purple-soft: rgba(81, 43, 212, 0.15);
      --dark: #1a1a2e;
      --ink: #0f1117;
      --paper: #ffffff;
      --mute: #8a8fa3;
      --mute-light: #c2c5cf;
      --teal: #00d4aa;
      --teal-dim: rgba(0, 212, 170, 0.15);
      --max-width: 1120px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 80px; }

    body {
      font-family: 'Space Grotesk', -apple-system, system-ui, sans-serif;
      color: var(--paper);
      background: var(--ink);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    .skip-link {
      position: absolute;
      top: -100px;
      left: 16px;
      background: var(--purple);
      color: var(--paper);
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      z-index: 200;
      transition: top 0.15s;
    }

    .skip-link:focus {
      top: 8px;
    }

    :focus-visible {
      outline: 2px solid var(--teal);
      outline-offset: 2px;
    }

    /* ---- ANIMATIONS ---- */

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    @keyframes fade-in-up {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0, 212, 170, 0.7); }
      50% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(0, 212, 170, 0); }
    }

@keyframes terminal-glow {
      0%, 100% { box-shadow: 0 8px 60px rgba(0, 212, 170, 0.08), 0 2px 20px rgba(81, 43, 212, 0.15); }
      50% { box-shadow: 0 8px 80px rgba(0, 212, 170, 0.12), 0 2px 30px rgba(81, 43, 212, 0.25); }
    }

    @keyframes type-line {
      from { width: 0; }
      to { width: 100%; }
    }

    /* Scroll reveal — only applied to elements well below the fold */
    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ---- NAV ---- */

    /* ---- HERO ---- */

    .hero {
      background:
        radial-gradient(ellipse 700px 500px at 50% 35%, rgba(81, 43, 212, 0.14) 0%, transparent 70%),
        radial-gradient(ellipse 400px 300px at 50% 60%, rgba(0, 212, 170, 0.06) 0%, transparent 70%),
        linear-gradient(175deg, var(--ink) 0%, var(--dark) 50%, var(--ink) 100%);
      padding: 80px 32px 100px;
      position: relative;
      overflow: hidden;
    }

    .hero-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 60px;
      align-items: center;
      min-width: 0;
    }

    .hero-inner > * {
      min-width: 0;
    }

    .hero-text {
      animation: fade-in-up 0.7s ease-out both;
    }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--teal-dim);
      border: 1px solid rgba(0, 212, 170, 0.3);
      border-radius: 100px;
      padding: 6px 18px;
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--teal);
      margin-bottom: 24px;
    }

    .hero-pill-dot {
      width: 6px;
      height: 6px;
      background: var(--teal);
      border-radius: 50%;
      flex-shrink: 0;
      animation: pulse-dot 2s ease-in-out infinite;
    }

    .hero h1 {
      font-size: 3.4rem;
      font-weight: 700;
      color: var(--paper);
      line-height: 1.08;
      margin-bottom: 16px;
      letter-spacing: -0.03em;
    }

    .hero .sub-tagline {
      font-size: 1.25rem;
      color: var(--mute-light);
      font-weight: 500;
      letter-spacing: -0.01em;
      margin-bottom: 20px;
    }

    .hero .descriptor {
      font-size: 1.08rem;
      color: var(--mute-light);
      margin-bottom: 36px;
      max-width: 480px;
      line-height: 1.65;
    }

    .hero-buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      margin-bottom: 20px;
    }

    .social-proof {
      font-size: 0.88rem;
      color: var(--mute-light);
      margin-top: 8px;
    }

    .social-proof a {
      color: var(--teal);
      text-decoration: none;
      font-weight: 500;
    }
    .social-proof a:hover {
      text-decoration: underline;
    }

    /* ---- LIVE STAT PILLS ---- */

    .hero-stats {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 8px;
      min-height: 34px;
    }

    .community-stats {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: center;
      margin: -24px 0 40px;
      min-height: 34px;
    }

    .stat-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 100px;
      padding: 7px 16px;
      font-size: 0.8rem;
      font-weight: 500;
      color: var(--mute-light);
      text-decoration: none;
      transition: border-color 0.2s, background 0.2s, color 0.2s;
    }

    .stat-pill[hidden] { display: none; }

    .stat-pill:hover {
      border-color: rgba(81, 43, 212, 0.45);
      background: rgba(255, 255, 255, 0.08);
      color: var(--paper);
    }

    .stat-pill svg {
      width: 14px;
      height: 14px;
      flex-shrink: 0;
    }

    .stat-pill .stat-value {
      color: var(--teal);
      font-weight: 700;
      font-family: 'JetBrains Mono', monospace;
    }

    /* ---- TERMINAL (HERO) ---- */

    .hero-terminal-wrapper {
      animation: fade-in-up 0.7s ease-out 0.2s both;
    }

    .terminal {
      background: #0d0d14;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      overflow: hidden;
      animation: terminal-glow 4s ease-in-out infinite;
    }

    .terminal-chrome {
      background: rgba(255, 255, 255, 0.04);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .terminal-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }
    .terminal-dot.red { background: #ff5f57; }
    .terminal-dot.yellow { background: #febc2e; }
    .terminal-dot.green { background: #28c840; }

    .terminal-title {
      flex: 1;
      text-align: center;
      font-size: 0.72rem;
      color: var(--mute);
      font-family: 'JetBrains Mono', monospace;
    }

    .terminal-body {
      padding: 24px 20px 28px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.82rem;
      line-height: 1.9;
    }

    .terminal-line {
      white-space: nowrap;
      overflow: hidden;
    }

    .terminal-line .prompt {
      color: var(--teal);
      user-select: none;
    }

    .terminal-line .cmd {
      color: var(--teal);
    }

    .terminal-line .flag {
      color: var(--mute);
    }

    .terminal-line .url {
      color: var(--purple-hover);
    }

    .terminal-line .pipe {
      color: var(--mute);
    }

    .terminal-line .arg {
      color: var(--mute-light);
    }

    /* Typing animation on first line */
    .terminal-line.typing {
      display: inline-block;
      overflow: hidden;
      white-space: nowrap;
      animation: type-line 2.2s steps(55, end) 0.5s both;
    }

    /* Blinking cursor on last line */
    .terminal-cursor {
      display: inline-block;
      width: 8px;
      height: 16px;
      background: var(--teal);
      vertical-align: text-bottom;
      margin-left: 2px;
      animation: blink 1s step-end infinite;
    }

    /* ---- BUTTONS ---- */

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s, border-color 0.15s, transform 0.1s, box-shadow 0.3s;
      font-family: inherit;
      cursor: pointer;
    }

    .btn:active { transform: scale(0.97); }

    .btn-primary {
      background: var(--purple);
      color: var(--paper);
      border: 2px solid var(--purple);
      box-shadow: 0 0 20px rgba(81, 43, 212, 0.3), 0 0 60px rgba(81, 43, 212, 0.1);
    }

    .btn-primary:hover {
      background: var(--purple-hover);
      border-color: var(--purple-hover);
      box-shadow: 0 0 30px rgba(81, 43, 212, 0.5), 0 0 80px rgba(81, 43, 212, 0.25);
    }

    .btn-ghost {
      background: transparent;
      color: var(--mute-light);
      border: 2px solid rgba(255, 255, 255, 0.15);
    }

    .btn-ghost:hover {
      border-color: rgba(255, 255, 255, 0.35);
      color: var(--paper);
    }

    .btn-ghost svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .btn-lg {
      padding: 16px 32px;
      font-size: 1rem;
    }

    /* ---- SECTION HELPERS ---- */

    .section-label {
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--teal);
      margin-bottom: 12px;
    }

    .section-cta {
      text-align: center;
      margin-top: 48px;
    }

    /* ---- PROBLEM ---- */

    .problem {
      background: var(--dark);
      padding: 100px 32px 80px;
    }

    .problem-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 0.8fr 1.4fr;
      gap: 48px;
      align-items: center;
    }

    .problem-text {
      text-align: left;
    }

    .problem h2 {
      font-size: 2.4rem;
      font-weight: 700;
      line-height: 1.15;
      margin-bottom: 20px;
      letter-spacing: -0.02em;
    }

    .problem p {
      font-size: 1.1rem;
      color: var(--mute-light);
      line-height: 1.7;
    }

    .problem-divider {
      width: 48px;
      height: 3px;
      background: linear-gradient(90deg, var(--purple), var(--teal));
      border-radius: 4px;
      margin: 32px 0;
    }

    .problem-turn {
      color: var(--paper) !important;
    }

    .problem-turn em {
      color: var(--teal);
      font-style: normal;
      font-weight: 600;
    }

    .approval-showcase {
      position: relative;
    }

    .approval-showcase img {
      width: 100%;
      height: auto;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .approval-showcase img:hover {
      transform: scale(1.02);
      box-shadow: 0 8px 40px rgba(81, 43, 212, 0.25);
    }

    .approval-showcase .expand-hint {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: rgba(0, 0, 0, 0.6);
      border-radius: 6px;
      padding: 6px 10px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.72rem;
      color: var(--mute-light);
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s;
    }

    .approval-showcase:hover .expand-hint {
      opacity: 1;
    }

    .approval-caption {
      font-size: 0.88rem;
      color: var(--mute-light);
      margin-top: 16px;
      text-align: center;
    }

    /* Lightbox */
    .lightbox {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.9);
      z-index: 1000;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      padding: 40px;
    }

    .lightbox.open {
      display: flex;
    }

    .lightbox img {
      max-width: 100%;
      max-height: 100%;
      border-radius: 12px;
      box-shadow: 0 16px 80px rgba(81, 43, 212, 0.3);
    }

    .lightbox-close {
      position: absolute;
      top: 20px;
      right: 24px;
      background: none;
      border: none;
      color: var(--mute-light);
      font-size: 2rem;
      cursor: pointer;
      line-height: 1;
      padding: 8px;
    }

    .lightbox-close:hover {
      color: var(--paper);
    }

    /* ---- HOW IT WORKS (Flow Diagram) ---- */

    .how-it-works {
      background:
        radial-gradient(ellipse 500px 300px at 50% 60%, rgba(0, 212, 170, 0.04) 0%, transparent 70%),
        var(--ink);
      padding: 80px 32px 100px;
    }

    .how-it-works-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      text-align: center;
    }

    .how-it-works-inner h2 {
      font-size: 2.2rem;
      font-weight: 700;
      margin-bottom: 16px;
      letter-spacing: -0.02em;
    }

    .how-it-works-inner > p {
      font-size: 1rem;
      color: var(--mute-light);
      margin-bottom: 40px;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    }

    .flow-diagram {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      justify-content: center;
      flex-wrap: nowrap;
    }

    .flow-stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .flow-stage-label {
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--mute);
    }

    .flow-node {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 18px 24px;
      text-align: center;
      min-width: 150px;
    }

    .flow-node-agent {
      background: rgba(81, 43, 212, 0.1);
      border-color: var(--purple);
    }

    .flow-node-result {
      background: rgba(0, 212, 170, 0.08);
      border-color: var(--teal);
    }

    .flow-node h4 {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.05rem;
      font-weight: 500;
      color: var(--paper);
      margin-bottom: 4px;
    }

    .flow-node p {
      font-size: 0.85rem;
      color: var(--mute);
      line-height: 1.4;
    }

    .flow-triggers {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .flow-trigger-pill {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      padding: 12px 22px;
      font-size: 0.92rem;
      color: var(--mute-light);
    }

    .flow-arrow {
      display: flex;
      align-items: center;
      padding-top: 28px;
      color: var(--teal);
      flex-shrink: 0;
    }

    .flow-arrow svg {
      width: 32px;
      height: 12px;
    }

    .flow-branch {
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-items: center;
    }

    .flow-branch-label {
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .flow-branch-label.yes { color: var(--teal); }
    .flow-branch-label.no { color: var(--mute); }

    .flow-branch-row {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .flow-diamond {
      width: 100px;
      height: 100px;
      position: relative;
      margin: 0 auto;
    }

    .flow-diamond-shape {
      width: 72px;
      height: 72px;
      transform: rotate(45deg);
      background: rgba(81, 43, 212, 0.07);
      border: 1px solid var(--purple);
      border-radius: 6px;
      position: absolute;
      top: 50%;
      left: 50%;
      margin-left: -36px;
      margin-top: -36px;
    }

    .flow-diamond-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--paper);
      white-space: nowrap;
    }

    @media (max-width: 1080px) {
      .flow-diagram {
        display: none;
      }

      .flow-mobile {
        display: block;
      }
    }

    @media (min-width: 1081px) {
      .flow-mobile {
        display: none;
      }
    }

    .flow-mobile-steps {
      display: flex;
      flex-direction: column;
      gap: 0;
      max-width: 360px;
      margin: 0 auto;
      text-align: left;
    }

    .flow-mobile-step {
      display: flex;
      gap: 16px;
      padding: 16px 0;
    }

    .flow-mobile-num {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: var(--purple-soft);
      color: var(--teal);
      font-size: 0.82rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .flow-mobile-text h4 {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--paper);
      margin-bottom: 2px;
    }

    .flow-mobile-text p {
      font-size: 0.82rem;
      color: var(--mute);
      line-height: 1.5;
    }

    .flow-mobile-connector {
      width: 2px;
      height: 16px;
      background: rgba(255, 255, 255, 0.06);
      margin-left: 15px;
    }

    /* ---- FEATURES ---- */

    .features {
      background: var(--ink);
      padding: 80px 32px 100px;
    }

    .features-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      text-align: center;
    }

    .features-inner h2 {
      font-size: 2.4rem;
      font-weight: 700;
      margin-bottom: 40px;
      letter-spacing: -0.02em;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      text-align: left;
      align-items: stretch;
    }

    .feature-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      padding: 32px 28px;
      transition: border-color 0.2s, transform 0.2s;
      display: flex;
      flex-direction: column;
    }

    .feature-card:hover {
      border-color: rgba(81, 43, 212, 0.3);
      transform: translateY(-2px);
    }

    .feature-icon {
      width: 48px;
      height: 48px;
      background: var(--purple-soft);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      color: var(--teal);
    }

    .feature-card h3 {
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 10px;
      color: var(--paper);
    }

    .feature-card p {
      font-size: 0.95rem;
      color: var(--mute-light);
      line-height: 1.6;
    }

    /* ---- GET STARTED ---- */

    .get-started {
      background: var(--ink);
      padding: 80px 32px 100px;
    }

    .get-started-inner {
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
    }

    .get-started-inner h2 {
      font-size: 2.2rem;
      font-weight: 700;
      margin-bottom: 40px;
      letter-spacing: -0.03em;
    }

    /* Install Tabs */
    .install-tabs {
      margin-bottom: 40px;
    }

    .tab-bar {
      display: flex;
      gap: 4px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 10px;
      padding: 4px;
      margin-bottom: 16px;
    }

    .tab {
      flex: 1;
      background: none;
      border: none;
      color: var(--mute);
      font-family: inherit;
      font-size: 0.85rem;
      font-weight: 500;
      padding: 10px 12px;
      border-radius: 8px;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
    }

    .tab:hover { color: var(--mute-light); }

    .tab.active {
      background: var(--purple-soft);
      color: var(--paper);
    }

    .tab-panel {
      display: none;
    }
    .tab-panel.active {
      display: block;
    }

    .tab-note {
      font-size: 0.85rem;
      color: var(--mute-light);
      margin-top: 10px;
    }

    .tab-note code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.78rem;
      background: rgba(255, 255, 255, 0.06);
      padding: 2px 6px;
      border-radius: 4px;
    }

    /* Code blocks */
    .code-block {
      background: #0d0d14;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      padding: 16px 20px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.82rem;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      overflow-x: auto;
    }

    .code-block code {
      white-space: nowrap;
      flex: 1;
    }

    .code-cmd { color: var(--teal); }
    .code-flag { color: var(--mute); }
    .code-url { color: var(--purple-hover); }
    .code-pipe { color: var(--mute); }

    .copy-btn {
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 6px;
      padding: 6px 8px;
      cursor: pointer;
      color: var(--mute-light);
      transition: color 0.15s, border-color 0.15s, background 0.15s;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .copy-btn:hover {
      color: var(--paper);
      border-color: rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.1);
    }

    .copy-btn.copied {
      color: var(--teal);
      border-color: rgba(0, 212, 170, 0.3);
    }

    /* Next steps */
    .next-steps {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .next-step {
      text-align: left;
    }

    .next-step-label {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--teal);
      margin-bottom: 8px;
    }

    .step-note {
      font-size: 0.88rem;
      color: var(--mute-light);
      margin-top: 8px;
    }

    /* ---- ECOSYSTEM / ARCHITECTURE ---- */

    .ecosystem {
      background: var(--dark);
      padding: 80px 32px 100px;
    }

    .ecosystem-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      text-align: center;
    }

    .ecosystem-inner h2 {
      font-size: 2.2rem;
      font-weight: 700;
      margin-bottom: 56px;
      letter-spacing: -0.02em;
    }

    .eco-items {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      text-align: left;
    }

    .eco-item {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      padding: 32px 28px;
      transition: border-color 0.2s;
      text-decoration: none;
      display: block;
      color: inherit;
    }

    .eco-item:hover {
      border-color: rgba(81, 43, 212, 0.3);
    }

    .eco-item h3 {
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 10px;
      color: var(--teal);
      font-family: 'JetBrains Mono', monospace;
    }

    .eco-item p {
      font-size: 0.9rem;
      color: var(--mute-light);
      line-height: 1.6;
    }

    /* ---- COMMUNITY ---- */

    .community {
      background:
        radial-gradient(ellipse 600px 400px at 50% 50%, rgba(81, 43, 212, 0.1) 0%, transparent 70%),
        var(--dark);
      padding: 100px 32px 80px;
      text-align: center;
    }

    .community-inner {
      max-width: var(--max-width);
      margin: 0 auto;
    }

    .community h2 {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 48px;
      letter-spacing: -0.02em;
    }

    .social-tiles {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .social-tile {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      padding: 16px 28px;
      color: var(--mute-light);
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 500;
      transition: border-color 0.2s, color 0.2s, background 0.2s;
    }

    .social-tile:hover {
      border-color: rgba(81, 43, 212, 0.4);
      color: var(--paper);
      background: rgba(255, 255, 255, 0.06);
    }

    .social-tile svg {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }

    /* ---- FOOTER ---- */

    .footer {
      background: var(--ink);
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding: 32px;
    }

    .footer-inner {
      max-width: var(--max-width);
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .footer-left a {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--mute);
      text-decoration: none;
      font-size: 0.82rem;
      transition: color 0.15s;
    }

    .footer-left a:hover {
      color: var(--mute-light);
    }

    .footer-left img {
      height: 20px;
      opacity: 0.7;
    }

    .footer-right {
      font-size: 0.78rem;
      color: var(--mute);
    }

    .footer-right a {
      color: var(--mute);
      text-decoration: none;
    }

    .footer-right a:hover {
      color: var(--mute-light);
    }

    /* ---- RESPONSIVE ---- */

    @media (max-width: 720px) {
      .hero {
        padding: 48px 20px 64px;
      }

      .hero-inner {
        grid-template-columns: 1fr;
        gap: 40px;
        text-align: center;
      }

      .hero-text {
        order: 1;
      }

      .hero-terminal-wrapper {
        order: 2;
      }

      .hero h1 {
        font-size: 2.4rem;
      }

      .hero .descriptor {
        max-width: 100%;
        margin-left: auto;
        margin-right: auto;
      }

      .hero h1 br { display: none; }

      .hero-buttons {
        flex-direction: column;
        align-items: center;
      }

      .hero-buttons .btn {
        width: 100%;
        max-width: 280px;
        justify-content: center;
      }

      .terminal-body {
        font-size: 0.7rem;
        padding: 16px 14px 20px;
        overflow-x: auto;
      }

      .code-block {
        flex-direction: column;
        gap: 8px;
      }

      .code-block code {
        overflow-x: auto;
        width: 100%;
        padding-bottom: 4px;
      }

      .copy-btn {
        align-self: flex-end;
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }

      .eco-items {
        grid-template-columns: 1fr;
      }

      .problem-inner {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .problem-text {
        text-align: center;
      }

      .problem-divider {
        margin-left: auto;
        margin-right: auto;
      }

      .problem h2,
      .features-inner h2,
      .get-started-inner h2,
      .ecosystem-inner h2,
      .community h2 {
        font-size: 1.6rem;
      }

      .social-tiles {
        flex-direction: column;
        align-items: center;
      }

      .footer-inner {
        flex-direction: column;
        text-align: center;
      }

      .btn-lg {
        padding: 14px 24px;
        font-size: 0.92rem;
      }
    }

    @media (min-width: 721px) and (max-width: 960px) {
      .feature-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .hero-inner {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero .descriptor {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-buttons {
        justify-content: center;
      }

      .hero h1 {
        font-size: 2.8rem;
      }

      .problem-inner {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .problem-text {
        text-align: center;
      }

      .problem-divider {
        margin-left: auto;
        margin-right: auto;
      }
    }
  </style>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <SiteNav />

  <main id="main-content">

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <div class="hero-pill">
          <span class="hero-pill-dot"></span>
          Open source · Apache 2.0
        </div>
        <h1>Run your own<br> agent.</h1>
        <p class="sub-tagline">Simple, secure, reliable agents.</p>
        <p class="descriptor">
          An AI agent that runs on your hardware, connects to the communications
          tools you and your team use &mdash; Slack, Discord, and more. Built with .NET. Open source.
        </p>
        <p style="font-size:0.85rem;color:var(--mute);margin-top:-20px;margin-bottom:28px;">Channels, web search, and network exposure are set up after install with <a href="/cli/config/" style="color:inherit;text-decoration:underline;text-underline-offset:3px;"><code style="font-family:'JetBrains Mono',monospace;background:rgba(255,255,255,0.06);padding:2px 6px;border-radius:4px;">netclaw config</code></a>.</p>
        <div class="hero-buttons">
          <a href="#get-started" class="btn btn-primary btn-lg">Get Started</a>
          <a href="https://github.com/netclaw-dev" class="btn btn-ghost btn-lg" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            View on GitHub
          </a>
        </div>
        <div class="hero-stats" aria-live="polite">
          <a class="stat-pill" href="https://github.com/netclaw-dev/netclaw/releases/latest" target="_blank" rel="noopener" data-stat="release" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            <span class="stat-label">Latest release</span>
            <span class="stat-value" data-release>&mdash;</span>
          </a>
          <a class="stat-pill" href="https://discord.gg/ayqrChDtNs" target="_blank" rel="noopener" data-stat="discord" hidden>
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            <span class="stat-value" data-discord-count>&mdash;</span>
            <span class="stat-label">in Discord</span>
          </a>
        </div>
        <p class="social-proof">Built by the team behind <a href="https://getakka.net" target="_blank" rel="noopener">Akka.NET</a></p>
      </div>

      <!-- Terminal -->
      <div class="hero-terminal-wrapper">
        <div class="terminal">
          <div class="terminal-chrome">
            <div class="terminal-dot red"></div>
            <div class="terminal-dot yellow"></div>
            <div class="terminal-dot green"></div>
            <span class="terminal-title">netclaw &mdash; bash</span>
          </div>
          <div class="terminal-body">
            <div class="terminal-line typing"><span class="prompt">$ </span><span class="cmd">curl</span> <span class="flag">-sSL</span> <span class="url">https://releases.netclaw.dev/install.sh</span> <span class="pipe">|</span> <span class="cmd">bash</span></div>
            <div class="terminal-line"><span class="prompt">$ </span><span class="cmd">netclaw</span> <span class="arg">init</span></div>
            <div class="terminal-line"><span class="prompt">$ </span><span class="cmd">netclaw</span> <span class="arg">daemon start</span></div>
            <div class="terminal-line"><span class="prompt">$ </span><span class="cmd">netclaw</span> <span class="arg">chat</span></div>
            <div class="terminal-line"><span class="prompt">$ </span><span class="cmd">netclaw</span> <span class="arg">config</span>  <span class="flag"># connect Slack, Discord, web search &amp; more</span><span class="terminal-cursor"></span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Get Started -->
  <section class="get-started" id="get-started">
    <div class="get-started-inner">
      <p class="section-label">Get Started</p>
      <h2>Up and running in two minutes</h2>

      <!-- Install tabs -->
      <div class="install-tabs">
        <div class="tab-bar" role="tablist" aria-label="Installation method">
          <button class="tab active" role="tab" id="tab-linux" aria-selected="true" aria-controls="panel-linux" data-tab="linux">Linux</button>
          <button class="tab" role="tab" id="tab-macos" aria-selected="false" aria-controls="panel-macos" data-tab="macos" tabindex="-1">macOS</button>
          <button class="tab" role="tab" id="tab-windows" aria-selected="false" aria-controls="panel-windows" data-tab="windows" tabindex="-1">Windows</button>
          <button class="tab" role="tab" id="tab-docker" aria-selected="false" aria-controls="panel-docker" data-tab="docker" tabindex="-1">Docker</button>
        </div>
        <div class="tab-panels">
          <div class="tab-panel active" id="panel-linux" role="tabpanel" aria-labelledby="tab-linux" data-panel="linux">
            <div class="code-block">
              <code><span class="code-cmd">curl</span> <span class="code-flag">-sSL</span> <span class="code-url">https://releases.netclaw.dev/install.sh</span> <span class="code-pipe">|</span> <span class="code-cmd">bash</span></code>
              <button class="copy-btn" aria-label="Copy to clipboard" data-copy="curl -sSL https://releases.netclaw.dev/install.sh | bash">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
            <p class="tab-note">Installs CLI + daemon to <code>~/.netclaw/bin</code>. Supports x64 and arm64. Open a new terminal, or run <code>. ~/.netclaw/env</code>, before <code>netclaw init</code>.</p>
          </div>
          <div class="tab-panel" id="panel-macos" role="tabpanel" aria-labelledby="tab-macos" data-panel="macos">
            <div class="code-block">
              <code><span class="code-cmd">curl</span> <span class="code-flag">-sSL</span> <span class="code-url">https://releases.netclaw.dev/install.sh</span> <span class="code-pipe">|</span> <span class="code-cmd">bash</span></code>
              <button class="copy-btn" aria-label="Copy to clipboard" data-copy="curl -sSL https://releases.netclaw.dev/install.sh | bash">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
            <p class="tab-note">Same install script. Apple Silicon only (M1 and later). Open a new terminal, or run <code>. ~/.netclaw/env</code>, before <code>netclaw init</code>.</p>
          </div>
          <div class="tab-panel" id="panel-windows" role="tabpanel" aria-labelledby="tab-windows" data-panel="windows">
            <div class="code-block">
              <code><span class="code-cmd">iwr</span> <span class="code-flag">-useb</span> <span class="code-url">https://releases.netclaw.dev/install.ps1</span> <span class="code-pipe">|</span> <span class="code-cmd">iex</span></code>
              <button class="copy-btn" aria-label="Copy to clipboard" data-copy="iwr -useb https://releases.netclaw.dev/install.ps1 | iex">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
            <p class="tab-note">PowerShell. Installs to <code>%LOCALAPPDATA%\Programs\netclaw</code> and adds it to your User PATH. Restart your terminal before <code>netclaw init</code>.</p>
          </div>
          <div class="tab-panel" id="panel-docker" role="tabpanel" aria-labelledby="tab-docker" data-panel="docker">
            <div class="code-block">
              <code><span class="code-cmd">docker</span> <span class="code-flag">run -d --name</span> netclaw <span class="code-flag">-v</span> netclaw-home:/home/netclaw/.netclaw <span class="code-url">ghcr.io/netclaw-dev/netclaw</span></code>
              <button class="copy-btn" aria-label="Copy to clipboard" data-copy={"docker run -d --name netclaw -v netclaw-home:/home/netclaw/.netclaw ghcr.io/netclaw-dev/netclaw"}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              </button>
            </div>
            <p class="tab-note">Persists config and state in a named volume (the image runs as non-root <code>netclaw</code>). Configure with <code>NETCLAW_</code> env vars.</p>
          </div>
        </div>
      </div>

      <!-- Next steps -->
      <div class="next-steps">
        <div class="next-step">
          <span class="next-step-label">Then</span>
          <div class="code-block">
            <code><span class="code-cmd">netclaw</span> init</code>
            <button class="copy-btn" aria-label="Copy to clipboard" data-copy="netclaw init">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
          <p class="step-note">Pick your LLM provider, set your identity and security posture.</p>
        </div>
        <div class="next-step">
          <span class="next-step-label">Then</span>
          <div class="code-block">
            <code><span class="code-cmd">netclaw</span> daemon start <span class="code-flag">&&</span> <span class="code-cmd">netclaw</span> chat</code>
            <button class="copy-btn" aria-label="Copy to clipboard" data-copy="netclaw daemon start && netclaw chat">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
